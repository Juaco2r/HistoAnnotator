# =========================================================
# HistoAnnotator - files that must NOT be committed
# =========================================================

# Secrets / local configuration
.env
.env.*
!.env.example

# Certificates / signing keys
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/

# Local backups and patches
*.bak
*.bak-*
*.backup*
*.before-*
*backup-v*
*.zip

# Runtime / research data
/images/
/annotations/
/cache/
/caches/
/offline/
/downloads/

# Large pathology image formats
*.tif
*.tiff
*.svs
*.ndpi
*.mrxs
*.isyntax
*.ome.tif
*.ome.tiff
*.zarr

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node / Capacitor / Android
node_modules/
android-app/www/
android-app/android/.gradle/
android-app/android/**/build/

# Android local build state
android-app/android/local.properties
releases/

# Standalone local data
/data/

# Capacitor-generated Android web assets
android-app/android/app/src/main/assets/public/

# Local Android deployment overlay (private CA / environment-specific trust)
android-app/android/app/src/debug/res/

# HistoAnnotator Desktop development environment
.venv-desktop/
/build/
/dist/
